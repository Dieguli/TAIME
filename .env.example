# TAIME v2.0 configuration.
# Copy to .env and adjust as needed:  cp .env.example .env
# Only the variables the application actually reads are listed here.

# --- Server (host / non-Docker run) -----------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Storage ----------------------------------------------------------------
# Root for SQLite DB, uploaded datasets, trained artifacts, and HF assets.
# In Docker this is /data (a bind mount); on the host it defaults to ./data.
DATA_DIR=data

# SQLite database URL (defaults to sqlite:///<DATA_DIR>/taime.db if unset).
DATABASE_URL=sqlite:///data/taime.db

# Max upload size for dataset .zip files, in bytes (default 1 GiB).
# MAX_UPLOAD_BYTES=1073741824

# --- Training workers -------------------------------------------------------
# Size of the multiprocessing training pool. 1 is safest for the demo.
MAX_WORKERS=1

# --- Models & devices -------------------------------------------------------
# Fake-news (DistilBERT) base model directory. Baked into the Docker image by
# default; on the host, populate it with:  python scripts/fetch_models.py
# FAKE_NEWS_MODEL_DIR=data/hf/distilbert-base-cased

# Allow a runtime download of base HF models (e.g. distilbert-base-cased) when
# the local asset is absent. Leave unset for fully offline operation.
# TAIME_ALLOW_HF_DOWNLOAD=1

# Hate-speech (RoBERTa) model bundle used to hydrate the tokenizer/weights.
# Place your bundle under ./models_datasets/ and point this at it (or ship it
# inside the uploaded dataset .zip).
# HATE_SPEECH_MODEL_ZIP=models_datasets/FakeNews_HateSpeech_model.zip

# Restrict which GPUs are visible (GPU image only). Device is otherwise chosen
# per training job in the UI.
# CUDA_VISIBLE_DEVICES=0
