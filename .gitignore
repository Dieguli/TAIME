# Runtime data (SQLite, uploads, trained models, logs)
data/*
!data/.gitkeep
!data/datasets/
data/datasets/*
!data/datasets/.gitkeep
!data/models/
data/models/*
!data/models/.gitkeep
!data/logs/
data/logs/*
!data/logs/.gitkeep

# Vite build output (served by FastAPI)
apps/api/static/*
!apps/api/static/.gitkeep

# Environment files
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.eggs/
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyo
*.pyd

# Node.js
node_modules/
.npm
.pnpm-store/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
htmlcov/
.coverage
.tox/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.bak
*.tmp
.cache/
lightning_logs/

# Proprietary models & datasets — bring your own; never commit these.
# Runtime state under data/ is already ignored above (only .gitkeep is tracked).
models_datasets/*
!models_datasets/.gitkeep
!models_datasets/README.md
datasets/
output/
outputs/

# Large build/offline artifacts and internal material (never publish).
docker/wheels/
*.pptx
.agents/
.qa2/
.qa_tmp/
